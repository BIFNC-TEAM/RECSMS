# Copy to .env and supply your own secrets. Never commit .env.
STANDARD_ADMIN_PASSWORD=replace-with-a-long-admin-password
ONLYOFFICE_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# For remote deployment replace 127.0.0.1 with a host/IP reachable by user browsers.
ONLYOFFICE_PUBLIC_URL=http://127.0.0.1:8080
# Tencent Cloud SMS/CAPTCHA: fill locally, or use ignored data/tencent-auth.json.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_CAPTCHA_APP_ID=
TENCENT_CAPTCHA_SECRET_KEY=
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_ENDPOINT=sms.tencentcloudapi.com
