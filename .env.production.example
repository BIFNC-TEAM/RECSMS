# Copy to /home/ubuntu/rsms/.env, chmod 600. Do not commit or paste secrets into chat.
# URL-encode special characters in URL usernames/passwords (e.g. @ -> %40).
# Exact database name is case-sensitive: RSMS_dev. Create it before first deployment.
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_PG_HOST:5432/RSMS_dev?sslmode=require
REDIS_URL=redis://:REPLACE_PASSWORD@REPLACE_REDIS_HOST:6379/0
REDIS_PREFIX=rsms:production:
COS_REGION=ap-beijing
COS_BUCKET=rsms-1325708495
COS_PREFIX=rsms/production
COS_SECRET_ID=REPLACE_COS_SECRET_ID
COS_SECRET_KEY=REPLACE_COS_SECRET_KEY
STANDARD_ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_12_CHARACTERS
STANDARD_COOKIE_SECURE=1
# ONLY trust the private reverse-proxy network; the gateway resets X-Forwarded-For.
STANDARD_TRUSTED_PROXIES=10.0.0.0/8
ONLYOFFICE_PUBLIC_URL=https://office.rsms.openzoo.net
ONLYOFFICE_INTERNAL_URL=http://documentserver
ONLYOFFICE_PLATFORM_URL=http://rsms_platform:8765
ONLYOFFICE_JWT_SECRET=REPLACE_WITH_EXISTING_DOCUMENTSERVER_SECRET
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_CAPTCHA_APP_ID=
TENCENT_CAPTCHA_SECRET_KEY=
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_ENDPOINT=sms.tencentcloudapi.com
